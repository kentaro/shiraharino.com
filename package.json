{
  "name": "hermes-diary",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A small public diary site for Shiraha Rino, built with TypeScript, Tailwind CSS, and Next.js.",
  "scripts": {
    "dev": "next dev",
    "gen": "node scripts/generate-feed.mjs",
    "build": "node scripts/generate-feed.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
